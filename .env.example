# Copy to .env for local development. Every secret also accepts a _FILE variant
# (DATABASE_URL_FILE=/run/secrets/db_url), which is what Docker secrets, Kubernetes
# projected volumes and the AWS Secrets Manager CSI driver mount.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# csv | postgres
PROPERTY_SOURCE=csv
CSV_PATH=./data/sre-ai-coding-test-data.csv

# Required when PROPERTY_SOURCE=postgres
DATABASE_URL=postgres://yaya:yaya@localhost:5432/yaya

# Refuse to start or load above this share of rejected rows
MAX_REJECTED_RATIO=0.2
